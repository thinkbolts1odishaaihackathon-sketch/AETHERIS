# AETHERIS AEOS Backend Environment Configuration

# Server Port (Render sets this automatically via $PORT)
PORT=3001

# Allowed CORS Origins (comma-separated list, or '*' for permissive dev)
# In production on Render, set this to your Vercel frontend URL, e.g.:
# CORS_ORIGINS=https://your-frontend-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Secret key for JWT signing (generate a random secure string in production)
JWT_SECRET=supersecret-aetheris-production-key-change-this-in-production

# PostgreSQL Database URL
# In Render, when you attach a PostgreSQL Database (Internal Connection String),
# Render automatically injects DATABASE_URL into your Web Service environment.
# Example: postgresql://aetheris_user:secretpassword@dpg-xxxxxx-a:5432/aetheris_db
# (If unset, backend automatically falls back to local SQLite at backend/aetheris.db)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname
