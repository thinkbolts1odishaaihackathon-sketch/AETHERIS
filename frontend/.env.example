# AETHERIS AEOS Frontend Environment Configuration (for Vercel & Local Development)

# 1. Authoritative Backend API Base URL
# When deploying to Vercel, set this environment variable in the Vercel Dashboard:
# (Project Settings -> Environment Variables) to your Render backend Web Service URL:
# Example: https://aetheris-aeos-backend.onrender.com
# In local development, you can omit this to proxy '/api' to http://localhost:3001
VITE_API_URL=https://your-backend-app.onrender.com

# 2. Google Gemini API Key for Live Multi-Agent Swarm Deliberation
# Get an API key from Google AI Studio: https://aistudio.google.com/app/apikey
# In Vercel, add this to Project Settings -> Environment Variables.
# The frontend will automatically initialize live Gemini intelligence on load!
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 3. Optional: Gemini Model Selection (defaults to gemini-1.5-flash)
# VITE_GEMINI_MODEL=gemini-1.5-flash
