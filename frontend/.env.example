# AETHERIS AEOS Frontend Environment Configuration

# Backend API Base URL
# When deploying to Vercel, set this environment variable in the Vercel Dashboard
# (Settings -> Environment Variables) to your Render backend URL:
# Example: https://aetheris-aeos-backend.onrender.com
#
# In local development, you can leave this blank or comment it out, and Vite will
# automatically proxy '/api' requests to http://localhost:3001.
VITE_API_URL=https://your-backend-app.onrender.com

# Optional: Google Gemini API Key for client-side multi-agent intelligence
# VITE_GEMINI_API_KEY=your_gemini_api_key_here
